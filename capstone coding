#include <stdio.h>
#include <mysql.h>
#include <string.h>

MYSQL *conn;

void connectDB() {
    conn = mysql_init(NULL);
    if (mysql_real_connect(conn, "localhost", "root", "Mysql@2026", "hospital_db", 3306, NULL, 0) == NULL) {
        printf("Connection Failed: %s\n", mysql_error(conn));
        return;
    }
    printf("Connected to MySQL Successfully!\n");
}

// 1. PATIENT MODULE
void addPatient() {
    int id, age; char name[50], disease[50], query[500];
    printf("\nEnter Patient ID: "); scanf("%d", &id);
    printf("Enter Name: "); scanf("%s", name);
    printf("Enter Age: "); scanf("%d", &age);
    printf("Enter Disease: "); scanf("%s", disease);
    sprintf(query, "INSERT INTO patients(id, name, age, disease) VALUES(%d, '%s', %d, '%s')", id, name, age, disease);
    if(mysql_query(conn, query)) printf("Failed: %s\n", mysql_error(conn));
    else printf("Patient Added!\n");
}

void viewPatients() {
    mysql_query(conn, "SELECT * FROM patients");
    MYSQL_RES *res = mysql_store_result(conn);
    MYSQL_ROW row;
    printf("\n--- Patients ---\n");
    while((row = mysql_fetch_row(res)))
        printf("ID:%s | Name:%s | Age:%s | Disease:%s\n", row[0], row[1], row[2], row[3]);
    mysql_free_result(res);
}

void searchPatient() {
    int id; char query[200];
    printf("\nEnter ID to Search: "); scanf("%d", &id);
    sprintf(query, "SELECT * FROM patients WHERE id=%d", id);
    mysql_query(conn, query);
    MYSQL_RES *res = mysql_store_result(conn);
    MYSQL_ROW row = mysql_fetch_row(res);
    if(row) printf("Found: ID:%s Name:%s Age:%s Disease:%s\n", row[0], row[1], row[2], row[3]);
    else printf("Not Found!\n");
    mysql_free_result(res);
}

void deletePatient() {
    int id; char query[200];
    printf("\nEnter ID to Delete: "); scanf("%d", &id);
    sprintf(query, "DELETE FROM patients WHERE id=%d", id);
    mysql_query(conn, query);
    printf("Patient Deleted!\n");
}

