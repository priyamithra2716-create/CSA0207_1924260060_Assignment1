int main() {
    int choice;
    connectDB();
    while(1) {
        printf("\n===== HOSPITAL MANAGEMENT - ALL MODULES =====\n");
        printf("1. Add Patient\n2. View Patients\n3. Search Patient\n4. Delete Patient\n");
